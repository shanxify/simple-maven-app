
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout scm
                echo 'GitHub repository checked out successfully.'
            }
        }

        stage('Verify Kubernetes') {
            steps {
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"
                kubectl get nodes
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                writeFile file: 'j11-deployment.yaml', text: '''apiVersion: apps/v1
kind: Deployment
metadata:
  name: j11-github-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: j11-github
  template:
    metadata:
      labels:
        app: j11-github
    spec:
      containers:
      - name: nginx
        image: nginx:alpine
        ports:
        - containerPort: 80
'''
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"
                kubectl apply -f j11-deployment.yaml
                kubectl rollout status deployment/j11-github-deployment --timeout=180s
                kubectl get deployment j11-github-deployment
                kubectl get pods -l app=j11-github
                '''
            }
        }
    }

    post {
        success {
            echo 'Set 11 SUCCESS: GitHub changes trigger Kubernetes deployment.'
        }
        failure {
            echo 'Set 11 FAILED: Check Jenkins Console Output.'
        }
    }
}
