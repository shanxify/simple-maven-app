pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout scm
                echo 'Source code checked out from GitHub.'
            }
        }

        stage('Verify Docker and Kubernetes') {
            steps {
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"
                docker --version
                docker info
                kubectl get nodes
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                docker build -f Dockerfile-k8s -t j12-web:1.0 .
                docker images j12-web
                '''
            }
        }

        stage('Create Kubernetes Deployment') {
            steps {
                writeFile file: 'j12-deployment.yaml', text: '''apiVersion: apps/v1
kind: Deployment
metadata:
  name: j12-docker-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: j12-docker-web
  template:
    metadata:
      labels:
        app: j12-docker-web
    spec:
      containers:
      - name: web
        image: j12-web:1.0
        imagePullPolicy: Never
        ports:
        - containerPort: 80
'''
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"
                kubectl apply -f j12-deployment.yaml
                kubectl rollout status deployment/j12-docker-deployment --timeout=180s
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"
                kubectl get deployment j12-docker-deployment
                kubectl get pods -l app=j12-docker-web
                kubectl describe deployment j12-docker-deployment
                '''
            }
        }
    }

    post {
        success {
            echo 'Set 12 SUCCESS: Docker image built and deployed to Kubernetes.'
        }
        failure {
            echo 'Set 12 FAILED: Check Console Output for the failing stage.'
        }
    }
}
