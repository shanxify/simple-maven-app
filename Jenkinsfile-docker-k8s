
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        DOCKER_IMAGE = 'shanxify/j12-web'
        IMAGE_TAG = '1.0'
        KUBE_DEPLOYMENT = 'j12-docker-deployment'
        KUBE_APP_LABEL = 'j12-docker-web'
        DOCKER_EXE = 'C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_EXE = 'C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
        KUBECONFIG = 'C:\\Users\\sudha\\.kube\\config'
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout scm
                echo 'GitHub source checked out successfully.'
            }
        }

        stage('Verify Docker and Kubernetes') {
            steps {
                bat '''
                    set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                    set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"

                    docker --version
                    if errorlevel 1 exit /b 1

                    docker info
                    if errorlevel 1 exit /b 1

                    kubectl get nodes
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"

                    docker build -f Dockerfile-k8s -t %DOCKER_IMAGE%:%IMAGE_TAG% .
                    if errorlevel 1 exit /b 1

                    docker images %DOCKER_IMAGE%
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DH_USER',
                    passwordVariable: 'DH_TOKEN'
                )]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $docker = $env:DOCKER_EXE
                        $tokenFile = Join-Path $env:WORKSPACE "docker-token.tmp"

                        try {
                            if ($env:DH_USER -ne "shanxify") {
                                throw "Unexpected Docker Hub username in Jenkins credentials."
                            }

                            if ([string]::IsNullOrEmpty($env:DH_TOKEN)) {
                                throw "Docker Hub token is empty."
                            }

                            $utf8NoBom = New-Object System.Text.UTF8Encoding($false)

                            [System.IO.File]::WriteAllText(
                                $tokenFile,
                                $env:DH_TOKEN,
                                $utf8NoBom
                            )

                            $loginCommand = '"' + $docker + '" login --username "' + $env:DH_USER + '" --password-stdin < "' + $tokenFile + '"'

                            & $env:ComSpec /d /s /c $loginCommand

                            if ($LASTEXITCODE -ne 0) {
                                throw "Docker Hub login failed. Check the Jenkins credential."
                            }

                            Write-Host "Docker Hub login succeeded."

                            & $docker push "$($env:DOCKER_IMAGE):$($env:IMAGE_TAG)"

                            if ($LASTEXITCODE -ne 0) {
                                throw "Docker image push failed."
                            }

                            Write-Host "Docker image pushed successfully."
                        }
                        finally {
                            if (Test-Path $tokenFile) {
                                Remove-Item $tokenFile -Force
                            }

                            & $docker logout 2>$null | Out-Null
                        }
                    '''
                }
            }
        }

        stage('Create Kubernetes Deployment YAML') {
            steps {
                writeFile file: 'j12-deployment.yaml', text: '''apiVersion: apps/v1
kind: Deployment
metadata:
  name: j12-docker-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: j12-docker-web
  template:
    metadata:
      labels:
        app: j12-docker-web
    spec:
      containers:
      - name: web
        image: shanxify/j12-web:1.0
        imagePullPolicy: Always
        ports:
        - containerPort: 80
'''
                echo 'Kubernetes Deployment YAML created.'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '''
                    set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                    set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"

                    kubectl apply -f j12-deployment.yaml
                    if errorlevel 1 exit /b 1

                    kubectl rollout status deployment/j12-docker-deployment --timeout=240s
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    set "PATH=C:\\Users\\sudha\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                    set "KUBECONFIG=C:\\Users\\sudha\\.kube\\config"

                    kubectl get deployment j12-docker-deployment
                    if errorlevel 1 exit /b 1

                    kubectl get pods -l app=j12-docker-web
                    if errorlevel 1 exit /b 1

                    kubectl describe deployment j12-docker-deployment
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SET 12 SUCCESS: Docker image built, pushed and deployed to Kubernetes.'
        }

        failure {
            echo 'SET 12 FAILED: Check Console Output for the first failed stage.'
        }

        always {
            echo 'Set 12 pipeline execution finished.'
        }
    }
}
