
stage('Test Docker Hub Login') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'dockerhub-pat',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
        )]) {
            powershell '''
                $ErrorActionPreference = "Stop"

                Write-Host "Testing Docker Hub login..."
                Write-Host "Username: $env:DOCKER_USER"

                $env:DOCKER_PASS |
                    docker login --username $env:DOCKER_USER --password-stdin

                if ($LASTEXITCODE -ne 0) {
                    throw "Docker Hub login failed in Jenkins."
                }

                Write-Host "Docker Hub authentication successful."
            '''
        }
    }
}
