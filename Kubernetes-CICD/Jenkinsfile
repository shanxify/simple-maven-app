
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Maven Build') {
            steps {
                dir('Kubernetes-CICD') {
                    bat 'mvn clean package'
                }
            }
        }

        stage('Check Docker') {
            steps {
                bat 'where docker'
                bat 'docker --version'
                bat 'docker info'
            }
        }

        stage('Docker Build') {
            steps {
                dir('Kubernetes-CICD') {
                    bat 'docker build -t shanxify/java-app:latest .'
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-pat',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $env:DOCKER_PASS | docker login `
                            --username $env:DOCKER_USER `
                            --password-stdin

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }
                    '''

                    bat 'docker push shanxify/java-app:latest'
                }
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                withEnv([
                    'KUBECONFIG=C:\\Users\\sudha\\.kube\\config'
                ]) {
                    dir('Kubernetes-CICD') {
                        bat 'kubectl config current-context'
                        bat 'kubectl get nodes'
                        bat 'kubectl apply -f deployment.yaml'
                        bat 'kubectl rollout status deployment/java-app --timeout=120s'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the first error in Console Output.'
        }
    }
}
